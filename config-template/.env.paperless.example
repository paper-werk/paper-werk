# Paperless-ngx (Service "paperless"): alle Variablen, die nur dieser eine
# Service braucht. Werte, die auch der paperless-db-Service braucht
# (POSTGRES_DB/USER/PASSWORD), stehen bewusst in .env, nicht hier; siehe
# docker-compose.yml (environment: PAPERLESS_DBNAME/DBUSER/DBPASS
# referenzieren sie von dort).

# Ab Paperless-ngx v3 Pflichtfeld. Generieren mit:
#   openssl rand -base64 48        (Git Bash/Mac/Linux, überall vorhanden)
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"   (nur mit Python)
PAPERLESS_SECRET_KEY=change-me
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change-me
PAPERLESS_OCR_LANGUAGE=deu
PAPERLESS_CSRF_TRUSTED_ORIGINS=http://localhost:8005
# PAPERLESS_URL=

# --- Interne Verdrahtung (Container-Namen aus diesem Compose-Stack) -----------
# Normalerweise unverändert lassen; diese Werte ergeben sich aus den
# Service-Namen in docker-compose.yml.

PAPERLESS_REDIS=redis://broker:6379
# Der Dienst heißt paperless-db, weil der Stack zwei Postgres-Dienste hat.
PAPERLESS_DBHOST=paperless-db
PAPERLESS_DBENGINE=postgresql
PAPERLESS_TIKA_ENABLED=1
PAPERLESS_TIKA_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_TIKA_ENDPOINT=http://tika:9998

# --- Worker / Consumer ---------------------------------------------------------

PAPERLESS_WEBSERVER_WORKERS=2
PAPERLESS_TASK_WORKERS=2
PAPERLESS_THREADS_PER_WORKER=2
PAPERLESS_CONSUMER_RECURSIVE=true
PAPERLESS_CONSUMER_SUBDIRS_AS_TAGS=true
PAPERLESS_CONSUMER_ENABLE_BARCODES=true
PAPERLESS_CONSUMER_ENABLE_ASN_BARCODE=true
# Wartezeit in Sekunden, die eine Datei im consume-Ordner unverändert bleiben
# muss, bevor Paperless sie verarbeitet (Paperless-ngx 3.x). Der Default von 5
# ist zu kurz, sobald ein Netzwerkscanner per SMB in den consume-Ordner
# schreibt: der legt die Datei erst leer an und füllt sie dann in Schüben.
# Paperless greift sonst Zwischenstände ab und meldet pro Scan mehrere
# fehlgeschlagene Verarbeitungen ("Unsupported mime type inode/x-empty" bzw.
# "unable to find trailer dictionary"), bevor ein Anlauf durchläuft, auf
# einem Jetson vier Fehlversuche für einen einzigen Scan-Stapel.
# 30 Sekunden decken die dort gemessenen Schreibpausen mit Reserve ab.
# inotify bleibt aktiv, der Ordner wird weiterhin sofort überwacht; es wird
# nur länger auf Ruhe gewartet, bevor die Verarbeitung startet.
# Die Paperless-2.x-Parameter PAPERLESS_CONSUMER_POLLING/_DELAY/_RETRY_COUNT
# sind in 3.x ersatzlos entfallen; Nachfolger ist das _POLLING_INTERVAL weiter
# unten; Polling gibt es also weiterhin, nur unter anderem Namen.
PAPERLESS_CONSUMER_STABILITY_DELAY=30
PAPERLESS_CONSUMER_BARCODE_SCANNER=ZXING

# --- PFLICHT auf Windows-Hosts (Docker Desktop), sonst kein Consume ----------
# WSL2 reicht bei Bind-Mounts von einem Windows-Laufwerk KEINE inotify-Events an
# den Container durch. Paperless meldet beim Start trotzdem
#   "Watching /usr/src/paperless/consume using native file system events"
# und wartet dann auf ein Ereignis, das nie kommt: die Dateien liegen im
# consume-Ordner, sind im Container per ls sichtbar, und es passiert nichts,
# ohne jede Fehlermeldung. Genau deshalb hier Polling statt inotify (Sekunden;
# 0 = inotify, der Default). Verifiziert am laufenden Code 3.x:
# settings.CONSUMER_POLLING_INTERVAL, gelesen in document_consumer.py.
#
# Das ist NICHT pauschal ein Docker-Desktop-Problem, sondern hängt am
# Dateisystem-Draht: unter macOS reicht der v3-Watcher über den Bind-Mount
# hinweg (gemessen mit v3.0.4), unter Windows/WSL2 nicht. Auf Linux-Hosts
# ebenfalls nicht nötig. Gemessen unter Windows: ohne diese Zeile blieben
# 15 Dokumente unbegrenzt liegen, mit ihr waren sie nach 15 s verarbeitet.
# PAPERLESS_CONSUMER_POLLING_INTERVAL=10
#
# Dazu auf einem Vorführ- oder Einzelplatzrechner ohne Netzwerkscanner die
# Stabilitätswartezeit oben auf 5 senken: 10 s Polling + 5 s Wartezeit ergeben
# gemessen rund 15 s vom Einlegen bis zum fertigen Dokument. Mit den 30 s von
# oben wären es rund 40 s, für eine Vorführung zu lang.

# --- AI Features (Mistral, OpenAI-kompatible API), kein lokales Ollama --------
# Key erstellen: https://console.mistral.ai/api-keys
# Zum Deaktivieren: PAPERLESS_AI_ENABLED=false setzen bzw. die restlichen
# PAPERLESS_AI_LLM_*-Zeilen entfernen.

PAPERLESS_AI_ENABLED=true
PAPERLESS_AI_LLM_BACKEND=openai-like
PAPERLESS_AI_LLM_ENDPOINT=https://api.mistral.ai/v1
PAPERLESS_AI_LLM_API_KEY=change-me
PAPERLESS_AI_LLM_MODEL=mistral-medium-3-5
PAPERLESS_AI_LLM_EMBEDDING_BACKEND=openai-like
PAPERLESS_AI_LLM_EMBEDDING_MODEL=mistral-embed

# --- Gemeinsame Anmeldung (OIDC, z. B. Microsoft Entra ID) -------------------
#
# AUSKOMMENTIERT UND ABSICHTLICH EIN ANGEBOT: Nicht jeder Betrieb hat ein
# Identitätsverzeichnis. Wer keins hat, lässt den Block stehen wie er ist und
# meldet sich weiter mit Benutzername und Passwort an.
#
# Was es tut: Paperless bekommt einen zweiten Anmeldeweg über allauth. Der
# Benutzer klickt "Anmelden mit ..." und landet beim Verzeichnis des Betriebs.
# Es kommt KEIN Container dazu; Paperless bringt das mit.
#
# Die Gegenstelle bei Microsoft ist eine App-Registrierung im Entra-Portal.
# Ihre Rückleitadresse muss auf DIESE Installation zeigen:
#
#   https://<adresse-des-archivs>/accounts/oidc/<provider_id>/login/callback/
#
# <provider_id> ist unten frei gewählt ("entra") und muss an beiden Stellen
# gleich lauten, im Portal und hier. Microsoft verlangt https, außer bei
# localhost.
#
# ACHTUNG, der Clientschlüssel und das Dollarzeichen: Compose liest auch die
# per env_file eingebundenen Dateien und würde ein $ als Variablennamen
# deuten; der Schlüssel wäre dann stillschweigend verstümmelt und die
# Anmeldung scheiterte mit einer Meldung über ungültige Zugangsdaten. Steht
# ein $ im erzeugten Schlüssel, im Portal einen neuen erzeugen.
#
# PAPERLESS_APPS=allauth.socialaccount.providers.openid_connect
# "fetch_userinfo":false ist bei Microsoft PFLICHT, nicht Kosmetik. allauth
# holt sonst zusätzlich die userinfo-Antwort und zieht sie dem ID-Token
# vor; bei Entra ist sie aber die ärmere Quelle: ohne email und ohne
# roles. Folge: Konten ohne Mailadresse.
# PAPERLESS_SOCIALACCOUNT_PROVIDERS={"openid_connect":{"APPS":[{"provider_id":"entra","name":"Microsoft","client_id":"change-me","secret":"change-me","settings":{"fetch_userinfo":false,"server_url":"https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration"}}]}}
#
# Legt beim ersten Anmelden ein Paperless-Konto an. Das Tor steht damit NICHT
# hier, sondern im Verzeichnis: Wer dort keine Rolle zugewiesen bekommt, wird
# schon vor der Rückleitung abgewiesen (Entra: Unternehmensanwendung ->
# Eigenschaften -> "Zuweisung erforderlich: Ja"). Ohne diese Zeile müsste
# jeder Benutzer vorher von Hand in Paperless angelegt werden.
# PAPERLESS_SOCIAL_AUTO_SIGNUP=true
#
# Protokoll, mit dem allauth die Rückleitadresse BAUT. Nicht zu verwechseln
# mit dem, unter dem der Server erreichbar ist. Der Default ist https und
# bleibt für jede Installation mit Zertifikat richtig. Nur eine Installation
# ohne TLS braucht hier http; sonst meldet Microsoft eine Rückleitadresse,
# die nicht zur Registrierung passt.
# PAPERLESS_ACCOUNT_DEFAULT_HTTP_PROTOCOL=https
#
# Rollen aus Entra -> Paperless. Der Anspruch heißt "roles" (App-Rollen),
# NICHT "groups": Der groups-Anspruch trägt bei Entra GUIDs statt Namen.
# Die Gruppen paper-werk-buero und paper-werk-projektleitung müssen in
# Paperless existieren; Paperless legt sie nicht an, sondern ordnet nur zu.
# Angelegt werden sie samt Rechten und Freigaben von
# "setup.sh --project ... sso". Jede Person bekommt im Portal genau EINE
# Rolle; im Archiv sehen alle drei dasselbe. Rolle und Gruppe
# #heissen in Entra, Paperless und paper-werk-app gleich.
#
# ACHTUNG: Bei JEDER Anmeldung werden die Gruppen des Kontos durch die aus
# Entra ERSETZT (groups.set(..., clear=True) in paperless/signals.py). Von
# Hand in Paperless vergebene Gruppen verschwinden beim nächsten Login -
# gepflegt wird ausschließlich im Verzeichnis.
# PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS=true
# PAPERLESS_SOCIAL_ACCOUNT_SYNC_GROUPS_CLAIM=roles
#
# Wer diese Rolle hat, wird bei der Anmeldung Superuser und verliert das
# beim nächsten Login wieder, wenn Entra ihm die Rolle entzieht. Braucht
# keine Paperless-Gruppe; verglichen wird direkt mit dem Anspruch.
# PAPERLESS_SOCIAL_ACCOUNT_SYNC_SUPERUSER_GROUP=paper-werk-superuser
#
# ERST SETZEN, WENN DIE ANMELDUNG EINMAL GELAUFEN IST. Die erste Zeile nimmt
# das Anmeldeformular von der Oberfläche, die zweite leitet direkt zum
# Verzeichnis weiter. Beide betreffen nur die Oberfläche: API und
# Django-Admin (/admin/) bleiben erreichbar, und damit bleibt auch der Weg
# herein, wenn das Verzeichnis einmal nicht antwortet.
# PAPERLESS_DISABLE_REGULAR_LOGIN=true
# PAPERLESS_REDIRECT_LOGIN_TO_SSO=true
