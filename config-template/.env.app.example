# paper-werk-app (Django): alle Variablen, die nur dieser eine Service
# braucht. DATABASE_URL steht bewusst NICHT hier, sondern wird in der
# docker-compose.yml aus den PAPERWERK_POSTGRES_*-Werten der .env
# zusammengesetzt, damit dieselben Zugangsdaten nicht an zwei Stellen stehen und
# auseinanderlaufen.
#
# Einrichtung:
#   cp .env.app.example .env.app
#   nano .env.app

# --- Pflicht -----------------------------------------------------------------
#
# Neu erzeugen mit:
#   python3 -c "from django.utils.crypto import get_random_string; print(get_random_string(50, 'abcdefghijklmnopqrstuvwxyz0123456789!@#%^&*(-_=+)'))"
#
# Das ist Djangos get_random_secret_key(), nur OHNE das Dollarzeichen im
# Alphabet. Der Grund: docker compose liest .env-Dateien selbst und ersetzt
# darin $NAME durch eine Umgebungsvariable. Ein Schlüssel mit Dollarzeichen
# wird dabei stillschweigend verstümmelt. Django liest ihn vollständig
# (django-environ interpoliert nicht), compose nicht. Die beiden sind sich dann
# uneins darüber, wie das Geheimnis lautet, und das Fehlerbild lautet
# "Sitzungen werden grundlos ungültig".
#
# Nicht stattdessen nachträglich das Zeichen entfernen: Das kürzt den
# Schlüssel unter 50 Zeichen, und dann meldet "manage.py check --deploy" zu
# Recht security.W009.
DJANGO_SECRET_KEY=change-me

# Unter welchen Namen die Anwendung sich ansprechen lässt. Der Servicename
# `paper-werk-app` MUSS darin stehen: n8n und Paperless erreichen Django über
# http://paper-werk-app:8000, nicht über localhost. Fehlt er, meldet Django
# "DisallowedHost", und zwar erst, wenn der erste Automatisierungslauf
# stattfindet.
#
# Dazu der Name oder die IP, unter der ein Mensch den Stack aufruft. Die
# Einstiegsseite verweist auf Port 8000 desselben Hosts.
DJANGO_ALLOWED_HOSTS=paper-werk-app,localhost,127.0.0.1,change-me

# Herkünfte, denen bei POST vertraut wird, also die Adresse, unter der die
# Anwendung tatsächlich im Browser steht, MIT Schema und Port. Fehlt sie,
# scheitert jedes Speichern im Admin mit "CSRF verification failed", und zwar
# erst NACH der Anmeldung: Man kommt hinein und kann nichts sichern.
DJANGO_CSRF_TRUSTED_ORIGINS=http://change-me:8000

# --- Ohne TLS ----------------------------------------------------------------
#
# Solange der Stack im lokalen Netz ohne Zertifikat läuft, MUSS das hier False
# sein: Sonst sendet der Browser das Sitzungscookie gar nicht erst zurück, und
# es kommt keine Anmeldung zustande.
DJANGO_COOKIE_SECURE=False

# Umleitung auf HTTPS. Default aus, und das ist eine bewusste Entscheidung
# gegen Djangos Empfehlung: True ohne erreichbares HTTPS ergibt eine
# Umleitungsschleife, und die Anwendung ist nicht erreichbar.
# Wer TLS hat, setzt es auf True.
# DJANGO_SSL_REDIRECT=True

# HSTS-Dauer in Sekunden. 0 heißt aus, und das ist der richtige Default: Ein
# einmal ausgelieferter Wert lässt sich beim Besucher nicht zurückziehen.
# DJANGO_HSTS_SEKUNDEN=0

# --- PDF-Erzeugung -----------------------------------------------------------
# Verzeichnis der GTK/Pango-DLLs, nur unter Windows nötig. Im Container liegt
# Pango im Systempfad, die Variable bleibt leer.
GTK_BIN_DIR=

# --- Postausgang (Rechnungsversand per E-Mail) --------------------------------
#
# Die App verschickt Belege über ein eigenes SMTP, nicht über n8n: Der
# Versand soll nicht an einem laufenden Workflow hängen.
#
# **Ohne EMAIL_HOST geht nichts hinaus.** Die Mail landet dann nur im
# Protokoll des Containers (docker compose logs paper-werk-app), samt Anhang-Vermerk.
# Das ist gewollt: So lässt sich eine neue Anlage durchspielen, bevor echte
# Post an Kunden geht. Der Knopf "Versenden" bleibt trotzdem sichtbar.
#
# Nach dem Eintragen den App-Container neu starten, er liest die .env.app
# nur beim Start.
# EMAIL_HOST=smtp.example.de
# EMAIL_PORT=587
# EMAIL_HOST_USER=rechnung@example.de
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_TIMEOUT=20

# Der Absender. Leer heißt: die E-Mail-Adresse der Firma aus den Stammdaten.
# Setzen, wenn der Postausgang nur eine bestimmte Adresse durchlässt (bei
# Microsoft 365 und den meisten Anbietern ist das die Adresse des Kontos).
# DEFAULT_FROM_EMAIL=rechnung@example.de

# Kopie jeder versendeten Mail als BCC an die Adresse der Firma. Das ersetzt
# die Ablage im Postausgang. Default an.
# FAKTURA_VERSAND_KOPIE=True

# --- Demodaten -----------------------------------------------------------------
# Darf auf dieser Anlage "manage.py seed_faktura" laufen?
#
# Der Befehl legt Demo-Rechnungen an und schreibt sie fest; dabei zieht er
# echte Nummern aus dem lückenlosen Rechnungskreis. Auf einer produktiven
# Installation wäre das eine Lücke, die sich einem Prüfer nicht erklären
# lässt. Deshalb bleibt der Schalter hier aus.
#
# Auf einer Test- oder Vorführinstallation gehört er auf True. Er wird
# gebraucht, weil JEDER Container mit DEBUG=False läuft (die Betriebs-
# einstellungen). Eine Sperre allein an DEBUG würde also auch den Teststack
# aussperren, der genau dafür da ist, durchgespielt zu werden.
# FAKTURA_DEMODATEN_ERLAUBT=True

# --- Passwortregeln --------------------------------------------------------------
# Einfache Passwörter zulassen? Leert AUTH_PASSWORD_VALIDATORS.
#
# Für eine Test- oder Vorführinstallation ist das gewollt: Dort entstehen
# Wegwerfkonten zum Durchklicken. Auf einer Anlage mit echten Daten gehört
# der Schalter weg: Sie nimmt sonst "1234" als Passwort an.
#
# ACHTUNG: Django meldet das von sich aus NICHT. Deshalb bringt paper-werk-app
# eine eigene Prüfung mit: "manage.py check --deploy" gibt dann
# paperwerk.W001 aus. Wer den Schalter setzt, sollte diese Warnung kennen und
# nicht wegsehen.
# DJANGO_EINFACHE_PASSWOERTER=True

# --- Name und Logo der Anwendung ---------------------------------------------
#
# Unter welchem Namen die Anwendung beim Kunden auftritt. Ohne Angabe heißt
# sie "Paper-Werk"; ein Betrieb, der anders heißen will, setzt diese Werte.
#
# Es zieht mit, was der Anwender bei der täglichen Arbeit sieht: Browsertab,
# Kopf der Seitenleiste, Anmeldeseite, die Seiten rund um die Anmeldung über
# Microsoft. Es bleibt, was nur sieht, wer die Anlage betreut: diese
# Variablennamen, die Containernamen, die Protokollzeilen, die Schnittstelle.
#
# **Die Gruppen paper-werk-buero, -projektleitung und -superuser bleiben
# ebenfalls.** Sie heißen in Entra ID, in Paperless und in der App gleich;
# wer sie hier umbenennt, bricht die gemeinsame Anmeldung an drei Stellen
# zugleich (siehe den Abschnitt zur Anmeldung weiter unten).
#
# Die Belege sind nicht betroffen: PDF, E-Rechnung und E-Mail tragen von
# jeher die Firma des Kunden aus den Stammdaten.

#PAPER_WERK_MARKE_NAME=Belegwerk

# Die kleine Zeile unter dem Namen. Ausdrücklich leer gesetzt blendet sie
# aus; ohne Angabe steht dort "Faktura, Projekte, Controlling".
#PAPER_WERK_MARKE_UNTERTITEL=

# Das Zeichen im farbigen Quadrat, solange kein Logo da ist. Ein Name aus
# Googles Material Symbols (https://fonts.google.com/icons).
#PAPER_WERK_MARKE_SYMBOL=receipt_long

# Das Logo des Betriebs: ein Pfad INNERHALB des Medienordners, also
# innerhalb des Volumes app-media unter /app/media. Hineinkopieren aus der
# Wurzel von paper-werk:
#
#   ./paper-werk compose exec paper-werk-app mkdir -p /app/media/marke
#   ./paper-werk compose cp logo.svg paper-werk-app:/app/media/marke/
#
# NICHT in den Quellordner der App legen: Statische Dateien sammelt
# "collectstatic" beim Bauen des Abbilds ein, eine nachträglich
# hineingelegte Datei bliebe dort unsichtbar.
#
# Das Logo ersetzt das Quadrat; der Name steht daneben. Etwa
# 38 Pixel hoch, quadratisch. Fehlt die Datei, zeigt die Oberfläche wieder
# das Symbol, ohne Fehlermeldung; gemeldet wird es von
#   docker compose exec paper-werk-app uv run python manage.py check
# als paperwerk.W002.
#PAPER_WERK_MARKE_LOGO=marke/logo.svg

# Eine eigene Fassung für den Dunkelmodus. Ohne Angabe gilt dieselbe Datei
# für beide; dann muss sie auf hellem wie auf dunklem Grund taugen.
#PAPER_WERK_MARKE_LOGO_DUNKEL=marke/logo-dunkel.svg

# Das Symbol im Browsertab, ebenfalls ein Pfad im Medienordner. Ohne Angabe
# das mitgelieferte SVG. Der Medientyp folgt der Dateiendung.
#PAPER_WERK_MARKE_FAVICON=marke/tab.png

# Wohin "Webseite anzeigen" im Benutzermenü der App führt. Ohne Angabe die
# Seite der KI-Werkstatt; auf einer Kundenanlage gehört hier die Seite des
# Betriebs hin. Leer gesetzt verschwindet der Verweis ganz.
#PAPER_WERK_MARKE_WEBSEITE=https://www.kunde.de

# ── Anbindung an das Archiv ───────────────────────────────────────────────────
#
# **Ohne diesen Block bleibt die Archivierung stumm aus**, und das ist die
# Hälfte, um die es geht: Ein festgeschriebener Beleg wandert dann NICHT nach
# Paperless, `manage.py paperless_einrichten` bricht ab mit "Paperless ist
# nicht eingerichtet", und der Seed läuft trotzdem durch. Nichts wird rot.
#

# Die Adresse aus Sicht des SERVERS.
#   im Stack       http://paperless:8000   (Servicename im Compose-Netz)
#   bei runserver  http://localhost:8005   (der veröffentlichte Port)
PAPERLESS_URL=http://paperless:8000

# Die Adresse, unter der ein MENSCH das Archiv im Browser erreicht. Darin
# liegt die Falle: "http://paperless:8000" kennt nur das Compose-Netz. Ein
# Verweis darauf ergäbe im Browser einen toten Link, sichtbar erst beim
# Draufklicken. Leer heißt "PAPERLESS_URL benutzen"; im Container gehört der
# Wert deshalb ausdrücklich gesetzt.
PAPERLESS_ANSICHT_URL=http://localhost:8005

# Schlüssel eines Paperless-Benutzers. Er entsteht erst, wenn Paperless läuft:
#   docker compose exec paperless python3 manage.py drf_create_token admin
# **Danach muss der App-Container neu starten**; er liest seine .env nur
# beim Start. Siehe Kundeninstallation.md, Schritt 5.
PAPERLESS_TOKEN=

# Der Hauptschalter. Aus heißt: Es wird nichts hochgeladen, geräuschlos -
# kein Fehler, keine Wartezeit. Für eine Anlage mit Archivweg auf True.
PAPERLESS_ARCHIVIERUNG=True

# Beim Festschreiben auf das Hochladen warten, statt es im Hintergrund laufen
# zu lassen. True gibt dem Menschen die Rückmeldung sofort, richtig für eine
# Einzelplatz- oder Vorführinstallation.
PAPERLESS_WARTEN_BEIM_FESTSCHREIBEN=True

# --- Gemeinsame Anmeldung (OIDC, z. B. Microsoft Entra ID) -------------------
#
# EIN ANGEBOT, kein Muss: Ohne SSO_CLIENT_ID gibt es keinen Knopf, und die
# Anwendung verhält sich wie bisher. Das Anmeldeformular des Admin bleibt
# auch MIT Anbieter stehen; es ist der Notfallweg, wenn das Verzeichnis
# nicht antwortet.
#
# Die Rückleitadresse, die im Portal eingetragen sein muss:
#   <adresse-der-app>/accounts/oidc/<SSO_PROVIDER_ID>/login/callback/
# Mit Paperless kann es DIESELBE App-Registrierung sein (zwei
# Rückleitadressen, ein Geheimnis). Die App-Rollen heissen wie die Gruppen
# in beiden Anwendungen: paper-werk-buero, paper-werk-projektleitung,
# paper-werk-superuser (siehe core/gruppen.py in paper-werk-app).
#
# ACHTUNG, Dollarzeichen im Clientschlüssel: Compose deutet $ auch in
# env_file-Dateien als Variable und verstümmelt den Wert still. Steht eines
# darin, im Portal einen neuen Schlüssel erzeugen.
# SSO_PROVIDER_ID=entra
# SSO_NAME=Microsoft
# SSO_SERVER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
# SSO_CLIENT_ID=
# SSO_SECRET=
# # Das Protokoll, mit dem die Rückleitadresse GEBAUT wird. https ist der
# # Default und richtig, sobald TLS davor steht; ohne TLS muss hier http stehen.
# SSO_HTTP_PROTOKOLL=https
