# =============================================================================
# paper-werk Stack: Compose & Host-Pfade
# =============================================================================
# Diese Datei enthält nur Werte, die Compose selbst für ${...}-Interpolation
# in der docker-compose.yml braucht (volumes:, hostname:, command:, build:) -
# das funktioniert nur aus .env, nie aus einer per env_file: eingebundenen
# Datei wie .env.kopia. Dazu die Postgres-Zugangsdaten, die jeweils ZWEI
# Services brauchen. Alles, was nur ein einzelner Container in seiner eigenen
# Laufzeitumgebung braucht (z.B. KOPIA_PASSWORD), steht in dessen eigener
# .env.* Datei (siehe README.md).
#
# Auf dem Server:
#   cp .env.example .env
#   cp .env.paperless.example .env.paperless
#   cp .env.kopia.example .env.kopia
#   cp .env.app.example .env.app
#   nano .env .env.paperless .env.kopia .env.app
#
# Kopia Docker: https://kopia.io/docs/installation/#docker-images

# --- Daten -------------------------------------------------------------------
#
# Alle Daten liegen in benannten Docker-Volumes (compose/docker-compose.yml,
# Block volumes:), nicht in Ordnern auf dem Host. Kopia sichert sie über eine
# Quelle /source/paper-werk, dazu diesen Installationsordner.
#
# Optional: Scanner-Ablage als Ordner auf dem Host, etwa für eine SMB-Freigabe.
# Unter Docker Desktop (Windows, Mac) dann in .env.paperless
# PAPERLESS_CONSUMER_POLLING_INTERVAL=10 setzen, sonst sieht Paperless neue
# Dateien nicht.
# PAPER_WERK_CONSUME_ORDNER=/srv/scans

# --- Der Eingang (Caddy) ------------------------------------------------------
#
# Ordner mit Caddyfile, Caddyfile.https und html/ (die Einstiegsseite). Hier
# steht nichts: ./stack.sh setzt den Pfad selbst, auf caddy/ im Projektordner,
# wenn es ihn dort gibt, sonst auf den der Vorlage. Wer eine eigene Seite will,
# kopiert compose/caddy/ in seinen Installationsordner; das genügt.
# PAPER_WERK_CADDY_DIR=/absoluter/pfad/zum/ordner
#
# Ohne HTTPS liefert Caddy die Einstiegsseite auf Port 80 unter jedem Namen
# aus, unter dem der Server erreichbar ist; hier ist nichts einzutragen. HTTPS
# mit Namen und Zertifikat kommt aus compose.https.yml.

# --- HTTPS (nur mit dem Zusatzstück compose.https.yml) ------------------------
#
# Ein Angebot, kein Muss: Ohne compose.https.yml liest diese Werte niemand.
# Einzelheiten dort und in Kundeninstallation.md, Abschnitt 7.
#
# Der Name, unter dem der Server im Netz erreichbar ist. Er steht im
# Zertifikat, und aus ihm werden alle Adressen von App und Archiv abgeleitet.
#
# NICHT ".local" verwenden: Die Endung ist nach RFC 6762 für mDNS reserviert.
# Apple-Geräte lösen sie ausschließlich darüber auf und ignorieren dabei die
# hosts-Datei. Das ergibt ein „bei mir geht es, bei dir nicht“, dessen Suche
# an der falschen Stelle beginnt. Für lokale Netze ist
# „paper-werk.home.arpa" richtig (RFC 8375) oder eine eigene Subdomain.
# PAPER_WERK_HOSTNAME=paper-werk.kunde.de
#
# Woher das Zertifikat kommt: "intern" (Caddy ist seine eigene
# Zertifizierungsstelle) oder "datei" (vom Kunden: zertifikat.pem und
# schluessel.pem).
# PAPER_WERK_TLS_MODE=intern
#
# Nur bei "datei": der Ordner mit den beiden Dateien. Außerhalb des Repos oder
# als zertifikate/ im Projektordner; nur dieser Name ist gitignoriert.
# PAPER_WERK_CERT_PATH=/pfad/zum/ordner

# --- Kopia Web-UI (Compose interpoliert diese Werte in hostname:/command:) ----

KOPIA_HOSTNAME=paper-werk-kopia
KOPIA_SERVER_USERNAME=admin
KOPIA_SERVER_PASSWORD=change-me

# --- Postgres für PAPERLESS (paperless-db UND paperless) ---------------------
# Im paperless-Service als PAPERLESS_DBNAME/DBUSER/DBPASS gesetzt.
# Der Datenbankname bleibt "paperless": Das IST die Datenbank von Paperless.
# Ihn umzubenennen wäre eine Datenmigration, kein Namenswechsel.

POSTGRES_DB=paperless
POSTGRES_USER=paperless
POSTGRES_PASSWORD=change-me

# --- Postgres für PAPER-WERK-APP (paper-werk-db UND paper-werk-app) ----------
#
# Eigene Instanz, eigenes Volume, getrennt von der von Paperless.
# Begründung steht im Compose beim paper-werk-db-Service: Ein Restore spielt
# das komplette Postgres-Volume zurück, und Rechnungsdaten sind
# aufbewahrungspflichtig.

PAPERWERK_POSTGRES_DB=paperwerk
PAPERWERK_POSTGRES_USER=paperwerk
PAPERWERK_POSTGRES_PASSWORD=change-me

# --- paper-werk-app: Image oder Quelltext -------------------------------------
# Ohne Angabe läuft das Image aus der Registry in der Version, die
# compose/docker-compose.yml vorgibt. Festhalten oder vorziehen:
# PAPER_WERK_APP_VERSION=0.1.15
#
# Nur mit APP_BAUEN=ja in instanz.conf: Der Code liegt im Repo
# `paper-werk-app`. Hier steht nichts: ./stack.sh setzt
# den Pfad selbst auf das Repo NEBEN paper-werk, so wie
# Kundeninstallation.md es anlegt.
#
# Wer es doch hier setzt, behält das letzte Wort; dann bitte ein ABSOLUTER
# Pfad. Ein relativer wird gegen den PROJEKTORDNER aufgelöst (nicht gegen die
# Vorlage), und "../paper-werk-app" zeigte damit auf projekte/paper-werk-app -
# der Bau brach mit "path not found" ab.
# PAPER_WERK_APP_CONTEXT=/absoluter/pfad/zu/paper-werk-app

