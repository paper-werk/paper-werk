# Kopia: Umgebungsvariablen (Container)
#
# Einrichtung:
#   cp .env.kopia.example .env.kopia
#   nano .env.kopia
#
# Web-UI-Benutzer/Passwort: KOPIA_SERVER_USERNAME / KOPIA_SERVER_PASSWORD in .env
# Repository-Passwort: KOPIA_PASSWORD (hier)

# Passwort für das Verschlüsseln des Repository-Inhalts
KOPIA_PASSWORD=change-me-repo-password

# Anzeigename in der Kopia-UI (optional)
USER=User

TZ=Europe/Berlin
