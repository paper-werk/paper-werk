[
  {
    "_kommentar": "IDs sind bewusst fest und müssen zu den credentials-Referenzen in den n8n-Workflow-Dateien passen (dort per 'id' referenziert); so wird die Credential nach dem Import automatisch im Node vorausgewählt, ohne manuelles Nachziehen in der UI. Alle Workflows in n8n/ referenzieren genau diese drei IDs. Prüfen per: jq -c '[.nodes[] | select(.credentials != null) | .credentials | to_entries[] | {type: .key, id: .value.id, name: .value.name}] | unique' n8n/<datei>.json",
    "id": "0paJTBFFPS9HhU1N",
    "name": "Header Auth paperless",
    "type": "httpHeaderAuth",
    "data": {
      "name": "Authorization",
      "value": "Token HIER-PAPERLESS-API-TOKEN-EINTRAGEN"
    }
  },
