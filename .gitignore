# Lokale Env-Dateien (nie committen); Vorlagen *.example bleiben versioniert
.env*
!.env*.example

# Setup-Skripte: lokale Konfiguration mit Secrets (deckt auch alle
# projekte/*/setup/setup.conf ab)
**/setup.conf
**/n8n/credentials.json

# Claude-Code-Einstellungen dieser Arbeitsumgebung (Permission-Allowlist);
# rechnerspezifisch, nicht Teil des Projekts
.claude/settings.json

.DS_Store

# Installationen (siehe config-repos/README.md): config/ ist die eine
# Installation eines Rechners, config-repos/ hält mehrere für die Entwicklung.
# projekte/ ist der alte Ort, für ältere Installationen.
config/
config-repos/*
!config-repos/README.md
projekte/

# Python-Übersetzungsreste: demodaten/laden.py läuft im Container,
# beim Syntaxprüfen auf dem Host entsteht hier ein __pycache__.
__pycache__/

# Zertifikate für den HTTPS-Betrieb (compose.https.yml, PAPER_WERK_TLS_MODE=datei):
# Darin liegt der PRIVATE SCHLÜSSEL der Installation. Nie committen; wer
# ihn hat, kann sich als dieser Server ausgeben.
**/zertifikate/
*.pem
*.key

# Persönliche Notizen (notiz-*.md), etwa mit Zugangsdaten für einen Rechner.
**/notiz-*.md
